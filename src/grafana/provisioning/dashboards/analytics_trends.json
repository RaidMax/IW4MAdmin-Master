                    "rawSql": "SELECT \n    EXTRACT(HOUR FROM hour_bucket)::int as \"Hour\",\n    ROUND(AVG(total_players)::numeric, 1) as \"Avg Players\"\nFROM hourly_game_metrics\nWHERE hour_bucket >= $__timeFrom() AND hour_bucket <= $__timeTo()\nGROUP BY EXTRACT(HOUR FROM hour_bucket)\nORDER BY 1",
