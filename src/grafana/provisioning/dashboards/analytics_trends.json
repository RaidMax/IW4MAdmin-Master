        {
            "type": "table",
            "title": "Top Servers (by Player-Minutes)",
            "description": "Most active servers by total player engagement. Player-Minutes = absolute engagement, Avg Fill % = utilization efficiency.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 11
            },
            "id": 4,
            "datasource": {
                "type": "postgres",
                "uid": "${DS_POSTGRESQL}"
            },
            "targets": [
                {
                    "rawSql": "SELECT \n    COALESCE(s.hostname, hsm.server_id::text) as \"Server\",\n    hsm.game as \"Game\",\n    ROUND(SUM(hsm.player_minutes)::numeric, 1) as \"Player-Minutes\",\n    ROUND((AVG(hsm.avg_fill_rate) * 100)::numeric, 1) as \"Avg Fill %\",\n    MAX(hsm.max_players) as \"Peak\"\nFROM hourly_server_metrics hsm\nLEFT JOIN servers s ON hsm.server_id = s.id AND hsm.instance_id = s.instance_id\nWHERE hsm.hour_bucket >= $__timeFrom() AND hsm.hour_bucket <= $__timeTo()\nAND ('$game' = 'all' OR hsm.game = '$game')\nGROUP BY hsm.server_id, hsm.instance_id, s.hostname, hsm.game\nORDER BY SUM(hsm.player_minutes) DESC",
                    "format": "table"
                }
            ],
            "options": {
                "showHeader": true,
                "footer": {
                    "show": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "auto"
                    }
