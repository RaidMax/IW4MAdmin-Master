                    "rawSql": "SELECT \n    hour_bucket as time,\n    AVG(avg_fill_rate) as \"Fill Rate\"\nFROM hourly_server_metrics\nWHERE hour_bucket >= $__timeFrom() AND hour_bucket <= $__timeTo()\nAND ('$game' = 'all' OR game = '$game')\nGROUP BY hour_bucket\nORDER BY hour_bucket",
                    "format": "time_series"
                }
