        {
            "type": "table",
            "title": "Map Popularity",
            "description": "Total player engagement time per map. Player-Minutes = absolute engagement, Avg Fill Rate = utilization efficiency.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 2
            },
            "id": 1,
            "datasource": {
                "type": "postgres",
                "uid": "${DS_POSTGRESQL}"
            },
            "targets": [
                {
                    "rawSql": "SELECT \n    map || ' (' || game || ')' as \"Map\",\n    ROUND(SUM(total_player_minutes)::numeric, 1) as \"Player-Minutes\",\n    ROUND((AVG(avg_fill_rate) * 100)::numeric, 1) as \"Avg Fill %\",\n    MAX(peak_players) as \"Peak Players\",\n    SUM(unique_servers) as \"Servers\"\nFROM hourly_map_metrics\nWHERE hour_bucket >= $__timeFrom() AND hour_bucket <= $__timeTo()\nAND ('$game' = 'all' OR game = '$game')\nGROUP BY game, map\nHAVING SUM(total_player_minutes) > 0\nORDER BY SUM(total_player_minutes) DESC",
                    "format": "table"
                }
            ],
            "options": {
                "showHeader": true,
                "footer": {
                    "show": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "auto"
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Avg Fill %"
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "percent"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "type": "table",
            "title": "Map Popularity (Raw Player-Minutes)",
            "description": "Total player engagement time, regardless of server size",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 2
            },
            "id": 2,
            "datasource": {
                "type": "postgres",
                "uid": "${DS_POSTGRESQL}"
            },
            "targets": [
                {
                    "rawSql": "SELECT \n    map || ' (' || game || ')' as \"Map\",\n    ROUND(SUM(total_player_minutes)::numeric, 1) as \"Player-Minutes\",\n    SUM(appearance_count) as \"Appearances\",\n    MAX(peak_players) as \"Peak\"\nFROM hourly_map_metrics\nWHERE hour_bucket >= $__timeFrom() AND hour_bucket <= $__timeTo()\nAND ('$game' = 'all' OR game = '$game')\nGROUP BY game, map\nHAVING SUM(total_player_minutes) > 0\nORDER BY SUM(total_player_minutes) DESC",
                    "format": "table"
                }
            ],
            "options": {
                "showHeader": true,
                "footer": {
                    "show": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "auto"
                    }
                }
            }
        },
        {
            "type": "table",
            "title": "Map Stability (Stickiness)",
            "description": "Lower Churn Index = more stable player counts = higher player retention. Based on variance in player counts across hours.",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 10
            },
            "id": 14,
            "datasource": {
                "type": "postgres",
                "uid": "${DS_POSTGRESQL}"
            },
            "targets": [
                {
                    "rawSql": "SELECT \n    map || ' (' || game || ')' as \"Map\",\n    ROUND(AVG(peak_players)::numeric, 1) as \"Avg Players\",\n    ROUND(STDDEV(peak_players)::numeric, 2) as \"Std Dev\",\n    ROUND((STDDEV(peak_players) / NULLIF(AVG(peak_players), 0) * 100)::numeric, 1) as \"Churn Index %\",\n    CASE \n        WHEN STDDEV(peak_players) / NULLIF(AVG(peak_players), 0) < 0.2 THEN 'Very Stable'\n        WHEN STDDEV(peak_players) / NULLIF(AVG(peak_players), 0) < 0.4 THEN 'Stable'\n        WHEN STDDEV(peak_players) / NULLIF(AVG(peak_players), 0) < 0.6 THEN 'Moderate'\n        ELSE 'Volatile'\n    END as \"Stability\",\n    COUNT(*) as \"Hours Played\"\nFROM hourly_map_metrics\nWHERE hour_bucket >= $__timeFrom() AND hour_bucket <= $__timeTo()\nAND ('$game' = 'all' OR game = '$game')\nGROUP BY game, map\nHAVING COUNT(*) >= 3 AND AVG(peak_players) > 1\nORDER BY (STDDEV(peak_players) / NULLIF(AVG(peak_players), 0)) ASC NULLS LAST",
                    "format": "table"
                }
            ],
            "options": {
                "showHeader": true,
                "footer": {
                    "show": false
                }
            },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "align": "auto"
                    }
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Stability"
                        },
                        "properties": [
                            {
                                "id": "custom.displayMode",
                                "value": "color-background"
                            },
                            {
                                "id": "mappings",
                                "value": [
                                    {
                                        "type": "value",
                                        "options": {
                                            "Very Stable": {
                                                "color": "green",
                                                "index": 0
                                            }
                                        }
                                    },
                                    {
                                        "type": "value",
                                        "options": {
                                            "Stable": {
                                                "color": "super-light-green",
                                                "index": 1
                                            }
                                        }
                                    },
                                    {
                                        "type": "value",
                                        "options": {
                                            "Moderate": {
                                                "color": "yellow",
                                                "index": 2
                                            }
                                        }
                                    },
                                    {
                                        "type": "value",
                                        "options": {
                                            "Volatile": {
                                                "color": "red",
                                                "index": 3
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "matcher": {
                            "id": "byName",
                            "options": "Churn Index %"
                        },
                        "properties": [
                            {
                                "id": "custom.displayMode",
                                "value": "gradient-gauge"
                            },
                            {
                                "id": "thresholds",
                                "value": {
                                    "mode": "absolute",
                                    "steps": [
                                        {
                                            "color": "green",
                                            "value": null
                                        },
                                        {
                                            "color": "yellow",
                                            "value": 40
                                        },
                                        {
                                            "color": "red",
                                            "value": 60
                                        }
                                    ]
                                }
                            },
                            {
                                "id": "min",
                                "value": 0
                            },
                            {
                                "id": "max",
                                "value": 100
                            }
                        ]
                    }
                ]
            }
        },
