                    "rawSql": "SELECT \n    CASE EXTRACT(DOW FROM hour_bucket)::int\n        WHEN 0 THEN 'Sun'\n        WHEN 1 THEN 'Mon'\n        WHEN 2 THEN 'Tue'\n        WHEN 3 THEN 'Wed'\n        WHEN 4 THEN 'Thu'\n        WHEN 5 THEN 'Fri'\n        WHEN 6 THEN 'Sat'\n    END as \"Day\",\n    ROUND(AVG(total_players)::numeric, 1) as \"Avg Players\"\nFROM hourly_game_metrics\nWHERE hour_bucket >= $__timeFrom() AND hour_bucket <= $__timeTo()\nGROUP BY EXTRACT(DOW FROM hour_bucket)\nORDER BY EXTRACT(DOW FROM hour_bucket)",
